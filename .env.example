# F&J Workforce Limited - Production Environment Variables
# Duplicate to .env.local for local development

# Supabase Managed Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-for-server-operations-only

# Client Side (Vite / React SPA)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Notification Provider (Resend / Transactional)
RESEND_API_KEY=re_your_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://fjworkforce.com.ng
VITE_SITE_URL=https://fjworkforce.com.ng
